# ==========================================
# Environment Variables Template (.env.example)
# Copy this file to .env.local and fill in your values.
# ==========================================

# Node Environment (development / production)
NODE_ENV=development

# Maintenance Mode (set to "true" to enable maintenance page)
NEXT_PUBLIC_MAINTENANCE_MODE=false

# MongoDB Connection String (Read-only / Full DB access)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Admin Credentials (Used for admin dashboard authentication)
NEXT_PUBLIC_ADMIN_EMAIL=admin@tetrahedron.in
NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_admin_password

# Cloudinary Configuration (Used for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Used for contact form & application emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM=your_email@gmail.com
CONTACT_RECEIVER=info@tetrahedron.in
